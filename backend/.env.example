# Copia este archivo como `.env` en este directorio para cambiar los valores por defecto.
# Todos son opcionales. Las variables de entorno tienen prioridad sobre el archivo.

# URL de conexión de SQLAlchemy. Por defecto, un archivo SQLite en este directorio.
DATABASE_URL=sqlite:///./customers.db

# Orígenes con permiso para llamar a la API desde un navegador (CORS), separados por comas.
# El valor por defecto es el puerto del servidor de desarrollo de Vite.
CORS_ORIGINS=http://localhost:5173

# Solo lo lee el entrypoint del contenedor (Docker Compose), no la aplicación:
# con `false` se omite el seed al arrancar, lo que sirve para demostrar la lista vacía.
# SEED_ON_STARTUP=false
