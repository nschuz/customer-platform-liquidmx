# Variables de Docker Compose.
#
# Copia este archivo como `.env` en la raíz del repositorio para cambiar los valores por
# defecto. Es opcional: sin él, `docker compose up --build` funciona con los valores de abajo.
# Las variables definidas en el terminal tienen prioridad sobre el archivo `.env`.
# Tras cambiar un valor, aplica los cambios con `docker compose up -d`.

# ---------------------------------------------------------------------------
# Puerto donde se publica la API del backend en tu máquina.
# El contenedor siempre escucha en el 8000; este es el puerto de fuera.
# Si lo cambias, ajusta también PUBLIC_API_URL.
# Por defecto: 8000
# ---------------------------------------------------------------------------
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Puerto donde se publica el frontend en tu máquina.
# El contenedor siempre escucha en el 3000; este es el puerto de fuera.
# Si lo cambias, añade el nuevo origen (http://localhost:<puerto>) a CORS_ORIGINS.
# Por defecto: 3000
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------
# URL base del backend tal como la usa el NAVEGADOR.
# El navegador llama al backend directamente, sin pasar por el frontend: por eso es
# `localhost` con el puerto de tu máquina, y nunca el nombre interno del servicio (`backend`).
# Es una variable de TIEMPO DE EJECUCIÓN: el servidor del frontend la lee al arrancar, no al
# compilar la imagen. Cambiarla solo requiere `docker compose up -d frontend` (sin rebuild).
# - Con una URL: el frontend usa el backend real.
# - Vacía (`PUBLIC_API_URL=`): el frontend usa su API simulada.
# - Sin definir en este archivo: se usa el valor por defecto de abajo.
# Por defecto: http://localhost:8000
# ---------------------------------------------------------------------------
PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# `true` hace que la API simulada del frontend arranque sin clientes, para ver el estado
# "no hay clientes". Solo aplica cuando PUBLIC_API_URL está vacía; con el backend real no tiene
# efecto.
# Por defecto: false
# ---------------------------------------------------------------------------
MOCK_EMPTY=false

# ---------------------------------------------------------------------------
# Orígenes (esquema, host y puerto) a los que el backend permite llamarlo desde un navegador
# (CORS), separados por comas. Debe incluir la dirección con la que abres el frontend.
# Por defecto: el frontend en Docker (localhost y 127.0.0.1, puerto 3000) y el servidor de
# desarrollo de Vite (puerto 5173).
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Si el backend crea los 10 clientes de demostración al arrancar (después de las migraciones).
# Es idempotente: solo inserta los que falten, comparando por email.
# - `true`: los crea.
# - `false`: los omite, para demostrar la lista vacía.
# Por defecto: true
# ---------------------------------------------------------------------------
SEED_ON_STARTUP=true
