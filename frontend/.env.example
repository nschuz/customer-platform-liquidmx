# Copia este archivo como `.env` y ajusta los valores. `.env` no se versiona.
# Ambas variables se leen al arrancar el servidor: reinícialo tras cambiarlas.

# URL base del backend real, por ejemplo http://localhost:8000.
# La usa el navegador: si el frontend corre en Docker, pone la URL del host (http://localhost:8000),
# no el nombre del servicio (http://backend:8000).
# Sin definir o vacía: la app usa la API simulada incluida en este proyecto.
PUBLIC_API_URL=

# `true` hace que la API simulada arranque sin clientes, para ver el estado "no hay clientes".
# Solo aplica al modo simulado.
MOCK_EMPTY=false
